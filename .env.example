# Password used to sign in at /admin/login. The admin can change it later from
# Storefront → Admin password; that change is stored in the data store and
# overrides this value without a redeploy.
ADMIN_PASSWORD=change-this-password

# Long random string used to sign the admin session cookie
ADMIN_SECRET=change-this-to-a-long-random-string

# Optional: where products.json and settings.json are stored (defaults to ./data)
# DATA_DIR=./data

# Optional: Vercel Blob, used instead of the filesystem when set. A public store
# keeps admin edits and uploaded photos after redeploys on Vercel.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# BLOB_STORE_ID=store_...

# Optional: set to false if you serve the dashboard over plain HTTP
# ADMIN_COOKIE_SECURE=true

# Public site address, used for canonical links, Open Graph and sitemap.xml
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
