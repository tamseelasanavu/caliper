# Password used to sign in at /admin/login
ADMIN_PASSWORD=change-this-password

# Long random string used to sign the admin session cookie
ADMIN_SECRET=change-this-to-a-long-random-string

# Optional: where products.json and settings.json are stored (defaults to ./data)
# DATA_DIR=./data

# Optional: set to false if you serve the dashboard over plain HTTP
# ADMIN_COOKIE_SECURE=true

# Public site address, used for canonical links, Open Graph and sitemap.xml
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
